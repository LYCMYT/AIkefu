{
  "version": "1.0",
  "rules": {
    "resultsMustComeFromRuntime": true,
    "hardcodedReplyForbidden": true,
    "evalAssertionsMustNotEnterRag": true
  },
  "scenarios": [
    {
      "id": "SC-01-PRODUCT-CARE",
      "order": 1,
      "title": "商品知识有据回答",
      "shopKey": "shop_mia_fashion",
      "buyerKey": "buyer_002",
      "aiMode": "AUTO_ALLOWED",
      "objective": "证明商品卡先解析 product，再检索 ProductKnowledge，并自动发送低风险有据回复。",
      "steps": [
        { "actor": "SYSTEM", "action": "RESET_SHOWCASE" },
        { "actor": "BUYER", "action": "SEND_GOODS_CARD", "productKey": "fashion_hoodie" },
        { "actor": "BUYER", "action": "SEND_TEXT", "text": "这个可以放烘干机吗？" },
        { "actor": "SYSTEM", "action": "WAIT_FOR_BUYER_VISIBLE_REPLY", "timeoutMs": 60000 }
      ],
      "expected": {
        "tasks": ["PRODUCT_QUERY"],
        "context": { "productKey": "fashion_hoodie" },
        "evidence": {
          "minimumCount": 1,
          "mustIncludeScopes": ["PRODUCT"],
          "productKey": "fashion_hoodie"
        },
        "terminalMode": "AUTO",
        "mustContainSemantic": ["不建议烘干"],
        "forbiddenSemanticClaims": ["可以高温烘干"],
        "mustIncludeTraceStages": ["USER_TURN", "TASKS", "CONTEXT", "EVIDENCE", "REPLY_POLICY", "SEND_GUARD", "SEND_RECEIPT"]
      }
    },
    {
      "id": "SC-02-MULTI-TURN",
      "order": 2,
      "title": "连续消息与多轮上下文",
      "shopKey": "shop_mia_fashion",
      "buyerKey": "buyer_002",
      "aiMode": "ASSIST_ONLY",
      "objective": "证明短消息聚合、实时库存、尺码知识缺口安全降级和后续指代继承。",
      "steps": [
        { "actor": "SYSTEM", "action": "RESET_SHOWCASE" },
        { "actor": "BUYER", "action": "SEND_GOODS_CARD", "productKey": "fashion_hoodie" },
        { "actor": "BUYER", "action": "SEND_TEXT", "text": "黑色有吗？", "delayMs": 0 },
        { "actor": "BUYER", "action": "SEND_TEXT", "text": "XL呢？", "delayMs": 500 },
        { "actor": "BUYER", "action": "SEND_TEXT", "text": "我165，55公斤，想穿宽松一点。", "delayMs": 1000 },
        { "actor": "SYSTEM", "action": "WAIT_FOR_REPLY_DRAFT", "timeoutMs": 60000 },
        { "actor": "BUYER", "action": "SEND_TEXT", "text": "那白色呢？" },
        { "actor": "SYSTEM", "action": "WAIT_FOR_REPLY_DRAFT", "timeoutMs": 60000 }
      ],
      "expected": {
        "tasks": ["INVENTORY_QUERY", "SIZE_RECOMMENDATION"],
        "context": { "productKey": "fashion_hoodie" },
        "noKnowledgeEvidence": true,
        "terminalMode": "ASSIST",
        "rawMessageCountBeforeFirstTurn": 3,
        "mustIncludeTraceStages": ["USER_TURN", "TASKS", "CONTEXT", "EVIDENCE", "REPLY_POLICY"]
      }
    },
    {
      "id": "SC-03-STALE-REPLAN",
      "order": 3,
      "title": "生成中补充信息",
      "shopKey": "shop_mia_fashion",
      "buyerKey": "buyer_001",
      "aiMode": "AUTO_ALLOWED",
      "objective": "证明上下文变化会使旧回复失效，旧答案不会误发。",
      "preferredDriver": "scenario_lab:message_during_generation",
      "steps": [
        { "actor": "SYSTEM", "action": "RESET_SHOWCASE" },
        { "actor": "BUYER", "action": "SEND_TEXT", "text": "今天下单什么时候发货？" },
        { "actor": "SYSTEM", "action": "WAIT_FOR_REPLY_JOB_STATUS", "status": "GENERATING", "timeoutMs": 30000 },
        { "actor": "BUYER", "action": "SEND_TEXT", "text": "我是新疆的。" },
        { "actor": "SYSTEM", "action": "WAIT_FOR_BUYER_VISIBLE_REPLY", "timeoutMs": 60000 }
      ],
      "expected": {
        "oldReplyMustNotBeSent": true
      }
    },
    {
      "id": "SC-04-IMAGE-HUMAN",
      "order": 4,
      "title": "图片售后与人工接管",
      "shopKey": "shop_mia_fashion",
      "buyerKey": "buyer_004",
      "aiMode": "AUTO_ALLOWED",
      "objective": "证明图片管线、订单上下文、高风险分流和未执行动作不被虚假声明。",
      "steps": [
        { "actor": "SYSTEM", "action": "RESET_SHOWCASE" },
        { "actor": "BUYER", "action": "SEND_ORDER_CARD", "orderKey": "order_004" },
        { "actor": "BUYER", "action": "UPLOAD_IMAGE", "fixture": "AICS_FIXTURE:DAMAGED_SLEEVE", "displayLabel": "PIPELINE_FIXTURE" },
        { "actor": "BUYER", "action": "SEND_TEXT", "text": "收到就是这样的，我要退款并投诉。" },
        { "actor": "SYSTEM", "action": "WAIT_FOR_CONVERSATION_MODE", "mode": "MANUAL", "timeoutMs": 60000 }
      ],
      "expected": {
        "tasks": ["AFTER_SALES_QUERY", "REFUND_REQUEST", "COMPLAINT"],
        "context": { "orderKey": "order_004" },
        "evidence": {
          "minimumCount": 1,
          "mustIncludeScopes": ["STORE"]
        },
        "terminalMode": "MANUAL",
        "requiresHuman": true,
        "forbiddenSemanticClaims": ["已经退款", "退款已完成", "已经处理好"],
        "mustIncludeTraceStages": ["USER_TURN", "TASKS", "CONTEXT", "EVIDENCE", "REPLY_POLICY"]
      }
    },
    {
      "id": "SC-05-SAFE-GREETING",
      "order": 5,
      "title": "安全问候，无需知识也可自然回复",
      "shopKey": "shop_mia_fashion",
      "buyerKey": "buyer_001",
      "aiMode": "AUTO_ALLOWED",
      "objective": "证明纯问候不需要检索业务知识或调用模型，也能通过真实发送链路自然回复。",
      "steps": [
        { "actor": "SYSTEM", "action": "RESET_SHOWCASE" },
        { "actor": "BUYER", "action": "SEND_TEXT", "text": "你好！" },
        { "actor": "SYSTEM", "action": "WAIT_FOR_BUYER_VISIBLE_REPLY", "timeoutMs": 60000 }
      ],
      "expected": {
        "tasks": ["SAFE_SOCIAL_GREETING"],
        "terminalMode": "AUTO",
        "noKnowledgeEvidence": true,
        "mustContainSemantic": ["您好，我在的"],
        "mustIncludeTraceStages": ["BUILT_IN_SAFE_REPLY", "USER_TURN", "TASKS", "CONTEXT", "EVIDENCE", "REPLY_POLICY", "SEND_GUARD", "SEND_RECEIPT"]
      }
    },
    {
      "id": "SC-06-SHOP-AI-OFF",
      "order": 6,
      "title": "店铺 AI 关闭后只处理未来消息",
      "shopKey": "shop_mia_fashion",
      "buyerKey": "buyer_001",
      "aiMode": "AUTO_ALLOWED",
      "objective": "证明店铺 AI 关闭期间不创建 AI Job、Draft 或 Outbox；重新开启不会追溯旧消息，只处理此后的新消息。",
      "steps": [
        { "actor": "SYSTEM", "action": "RESET_SHOWCASE" },
        { "actor": "SYSTEM", "action": "SET_SHOP_AI_MODE", "mode": "MANUAL_ONLY" },
        { "actor": "BUYER", "action": "SEND_TEXT", "text": "关闭期间的消息不应在重新开启后被补处理。" },
        { "actor": "SYSTEM", "action": "WAIT_FOR_NO_AI_ARTIFACTS", "timeoutMs": 12000, "settleMs": 3000 },
        { "actor": "SYSTEM", "action": "SET_SHOP_AI_MODE", "mode": "AUTO_ALLOWED" },
        { "actor": "BUYER", "action": "SEND_TEXT", "text": "你好！" },
        { "actor": "SYSTEM", "action": "WAIT_FOR_BUYER_VISIBLE_REPLY", "timeoutMs": 60000 }
      ],
      "expected": {
        "tasks": ["SAFE_SOCIAL_GREETING"],
        "terminalMode": "AUTO",
        "noAiArtifactsBeforeFutureMessage": true,
        "mustContainSemantic": ["您好，我在的"],
        "mustIncludeTraceStages": ["BUILT_IN_SAFE_REPLY", "USER_TURN", "TASKS", "CONTEXT", "EVIDENCE", "REPLY_POLICY", "SEND_GUARD", "SEND_RECEIPT"]
      }
    }
  ],
  "optionalScenario": {
    "id": "SC-05-KNOWLEDGE-GROWTH",
    "title": "人工回答形成候选知识",
    "shopKey": "shop_mia_fashion",
    "buyerKey": "buyer_001",
    "question": "支持学校统一采购吗？",
    "expectedInitialGate": "NO_EVIDENCE",
    "humanReply": "支持，具体数量和报价需要联系人工客服确认。",
    "mustRequireReviewBeforePublish": true
  }
}
