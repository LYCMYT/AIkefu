# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_customer_service

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-customer-service-demo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# AI Provider (server only)
AI_BASE_URL=
AI_API_KEY=
AI_FAST_MODEL=
AI_QUALITY_MODEL=
AI_MULTIMODAL_MODEL=
AI_JUDGE_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIM=1536

# AI Runtime
AI_TIMEOUT_MS=8000
AI_RETRY_COUNT=1
AI_SCHEMA_REPAIR_COUNT=1
AI_GLOBAL_CONCURRENCY=6
AI_SHOP_CONCURRENCY=3
AI_SHOP_SEND_CONCURRENCY=1

# Conversation
REORDER_WAIT_MS=1000
TURN_IDLE_MS=2000
TURN_HARD_MAX_MS=5000
ASSIST_DRAFT_TTL_MS=300000
CONVERSATION_IDLE_CLOSE_MS=1800000

# Retention
CONVERSATION_RETENTION_DAYS=45
ATTACHMENT_RETENTION_DAYS=15
SUMMARY_RETENTION_DAYS=90
DEMO_WORKSPACE_IDLE_EXPIRY_HOURS=24

# Web
WEB_ORIGIN=http://localhost:5173
API_PORT=3000
WS_PATH=/ws
