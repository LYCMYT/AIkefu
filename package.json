{
  "name": "ai-customer-service-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "infra:bootstrap": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-infra.ps1",
    "dev": "dotenv -e .env -- pnpm --parallel --filter @ai-customer-service/api --filter @ai-customer-service/web dev",
    "start:api": "dotenv -e .env -- pnpm --filter @ai-customer-service/api start",
    "infra:up": "scripts\\\\docker-cmd.cmd compose up -d",
    "infra:down": "scripts\\\\docker-cmd.cmd compose down",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:unit": "node --test scripts/release-hygiene.test.mjs && node --test scripts/recording-timeline.test.mjs && pnpm -r --if-present test:unit",
    "test:recording": "node --test scripts/recording-timeline.test.mjs",
    "test:integration": "dotenv -e .env -- pnpm --filter @ai-customer-service/api test:integration",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @ai-customer-service/api prisma:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @ai-customer-service/api prisma:migrate",
    "db:deploy": "dotenv -e .env -- pnpm --filter @ai-customer-service/api prisma:deploy",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "ai:probe": "pnpm --filter @ai-customer-service/api build && dotenv -e .env -- node scripts/probe-ai-runtime.cjs",
    "ai:eval:offline": "pnpm --filter @ai-customer-service/api build && dotenv -e .env -- node apps/api/dist/eval/reply-eval.cli.js --offline-fixture",
    "ai:eval": "pnpm --filter @ai-customer-service/api build && dotenv -e .env -- node apps/api/dist/eval/reply-eval.cli.js --real-provider",
    "ai:eval:production:offline": "pnpm --filter @ai-customer-service/api build && dotenv -e .env -- node apps/api/dist/eval/production-reply-eval.cli.js --offline-fixture",
    "ai:eval:production": "pnpm --filter @ai-customer-service/api build && dotenv -e .env -- node apps/api/dist/eval/production-reply-eval.cli.js --real-provider",
    "ai:eval:auto:offline": "pnpm --filter @ai-customer-service/api build && dotenv -e .env -- node apps/api/dist/eval/production-reply-eval.cli.js --offline-fixture --auto-suite --fail-on-regression",
    "ai:eval:auto": "pnpm --filter @ai-customer-service/api build && dotenv -e .env -- node apps/api/dist/eval/production-reply-eval.cli.js --real-provider --auto-suite --fail-on-regression",
    "legacy:demo:record": "node scripts/record-demo.mjs",
    "legacy:demo:voiceover": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/generate-demo-voiceover.ps1",
    "legacy:demo:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-demo-video.ps1",
    "demo:record": "pnpm showcase:record",
    "demo:voiceover": "pnpm showcase:voice",
    "demo:build": "pnpm showcase:build",
    "showcase:record": "node scripts/record-showcase.mjs",
    "showcase:assets": "node scripts/write-recording-editorial-assets.mjs",
    "showcase:voice": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/generate-showcase-voiceover.ps1",
    "showcase:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-showcase-video.ps1",
    "showcase:video": "pnpm showcase:record && pnpm showcase:build",
    "video:v2:assets": "node scripts/video-v2/write-assets.mjs",
    "video:v2:record": "node scripts/video-v2/record.mjs && node scripts/video-v2/write-assets.mjs",
    "video:v2:compose": "node scripts/video-v2/write-assets.mjs && node scripts/video-v2/compose.mjs",
    "video:v2:verify": "node scripts/video-v2/verify.mjs",
    "test:video:v2": "node --test scripts/video-v2/spec.test.mjs",
    "release:archive": "node scripts/create-source-archive.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dotenv-cli": "^8.0.0"
  }
}
