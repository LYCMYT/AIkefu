# Copy to .env.production, replace every CHANGE_ME value with a distinct
# high-entropy base64url/URL-safe value, then keep .env.production out of
# version control. URL-safe values avoid ambiguous DATABASE_URL/REDIS_URL
# parsing because Compose constructs those server-side connection strings.
# This is a single-host, synthetic/Mock-only demo: do not add platform
# cookies, platform tokens, real commerce credentials, or browser VITE_* keys.

# Docker Compose project and the only host-published service.
COMPOSE_PROJECT_NAME=ai-customer-service-demo
WEB_PORT=8080
# Use the public origin seen by the browser. Set an HTTPS origin when TLS is
# terminated by a reverse proxy in front of this host.
WEB_ORIGIN=http://localhost:8080

# PostgreSQL / Redis / MinIO are internal-only Compose services. Do not expose
# their ports or reuse these placeholders outside this demo host.
POSTGRES_DB=ai_customer_service
POSTGRES_USER=ai_customer_service
POSTGRES_PASSWORD=CHANGE_ME_generate_a_unique_long_postgres_password
REDIS_PASSWORD=CHANGE_ME_generate_a_unique_long_redis_password
MINIO_ROOT_USER=CHANGE_ME_minio_access_key
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_a_unique_long_minio_password
S3_REGION=us-east-1
S3_BUCKET=ai-customer-service-demo
ATTACHMENT_STORAGE_TIMEOUT_MS=8000
JSON_BODY_LIMIT=1mb

# Demo behaviour. The default provider is deterministic and offline.
DEMO_WORKSPACE_IDLE_EXPIRY_HOURS=24
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_FAST_MODEL=
AI_QUALITY_MODEL=
AI_MULTIMODAL_MODEL=
AI_JUDGE_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIM=1536
AI_TIMEOUT_MS=8000
# Only the exact value true allows image bytes to leave the host. Keep false
# unless an explicitly approved server-side external runtime is configured.
AI_EXTERNAL_IMAGE_ANALYSIS_OPT_IN=false
