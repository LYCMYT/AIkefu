  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop                Shop?        @relation(fields: [shopId], references: [id], onDelete: SetNull)
  invocation          AIInvocation @relation(fields: [invocationId], references: [id], onDelete: Cascade)

  @@unique([invocationId, itemId, versionId])
  @@index([workspaceId, tenantId, shopId, invocationId])
}

