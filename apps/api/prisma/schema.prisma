  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  workspace               Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop                    Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation            Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, tenantId, shopId, conversationId, createdAt])
  @@index([createdAt])
}

model ReplyIncident {
  id String @id @default(cuid())
  workspaceId String
  tenantId String
  shopId String
  conversationId String
  replyMessageId String
  replyJobId String?
  errorType String
  severity String
  originalAnswerSnapshot String
  correctedAnswer String?
  correctionSendOutboxId String? @unique
  rootCause String?
  regressionCaseJson Json?
  regressionCaseId String?
  status ReplyIncidentStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  shop Shop @relation(fields:[shopId], references:[id], onDelete:Cascade)
  conversation Conversation @relation(fields:[conversationId], references:[id], onDelete:Cascade)
  regressionCase EvalCase? @relation(fields:[regressionCaseId], references:[id], onDelete:SetNull)
  correctionSendOutbox SendOutbox? @relation("IncidentCorrectionSend", fields:[correctionSendOutboxId], references:[id], onDelete:SetNull)
  @@index([workspaceId, tenantId, shopId, conversationId, status])
  @@index([createdAt])
}

model EvalCase {
  id String @id @default(cuid())
  workspaceId String
  tenantId String
  shopId String?
  key String
  source String
  inputJson Json
  expectedJson Json
  assertionsJson Json
  status String @default("ACTIVE")
  createdFromIncidentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  shop Shop? @relation(fields:[shopId], references:[id], onDelete:SetNull)
  incidents ReplyIncident[]
  @@unique([workspaceId, tenantId, key])
  @@index([workspaceId, tenantId, shopId, source, status])
  @@index([source, createdAt])
}

model TraceEvent {
  id String @id @default(cuid())
  workspaceId String
  tenantId String
  shopId String?
  conversationId String?
  replyJobId String?
  traceId String
  stage String
  payloadJson Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  shop Shop? @relation(fields:[shopId], references:[id], onDelete:SetNull)
  conversation Conversation? @relation(fields:[conversationId], references:[id], onDelete:SetNull)
  @@index([workspaceId, tenantId, conversationId, traceId, createdAt])
  @@index([createdAt])
}
