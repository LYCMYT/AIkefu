# Copy this file to .env for local development. Never commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_customer_service
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-customer-service-demo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
ATTACHMENT_STORAGE_TIMEOUT_MS=8000
DEMO_WORKSPACE_IDLE_EXPIRY_HOURS=24
WEB_ORIGIN=http://localhost:5173
API_PORT=3000
JSON_BODY_LIMIT=1mb
WS_PATH=/ws
# Leave as /api when using the Vite development proxy.
VITE_API_BASE_URL=/api
# Leave blank to connect Socket.IO to the browser origin.
VITE_WS_BASE_URL=
VITE_WS_PATH=/ws

# Optional server-only AI model gateway. Leave blank for the deterministic
# offline demo provider; never expose these values through VITE_* variables.
AI_PROVIDER=
# Required when AI_BASE_URL is set: deepseek, openai-compatible, responses,
# json-gateway, or custom-gateway. Wire formats are never guessed.
AI_API_STYLE=
AI_BASE_URL=
AI_API_KEY=
AI_API_KEY_FILE=
AI_FAST_MODEL=
AI_QUALITY_MODEL=
AI_MULTIMODAL_MODEL=
AI_JUDGE_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIM=1536
AI_TIMEOUT_MS=8000

# Uploaded images are untrusted and may contain PII. Keep local deterministic
# analysis by default: only the exact server-side value `true` permits raw
# image bytes to reach the configured external multimodal runtime. Never use
# a VITE_* variable for this switch.
AI_EXTERNAL_IMAGE_ANALYSIS_OPT_IN=false

# Opt-in only: runs PostgreSQL/pgvector/MinIO acceptance after infra:up + db:deploy.
RUN_REAL_INFRA_INTEGRATION=0
